#!/bin/bash
#
# Writes the current Omarchy theme's Logseq CSS into every Logseq graph.
#
# Called by Omarchy as: omarchy-hook theme-set <theme-name>
# Called by uninstall.sh as: logseq --remove
#
# Only the section between the two markers in <graph>/logseq/custom.css is
# replaced. Any CSS you wrote yourself stays untouched.

set -uo pipefail

# Omarchy 4 ("Quattro") moved the generated theme out of the config directory
# into the state directory. Older releases only have the config path, so try
# the new location first and fall back to the old one.
CURRENT_THEME_DIRS=(
  "$HOME/.local/state/omarchy/current/theme"
  "$HOME/.config/omarchy/current/theme"
)

THEME_CSS=""
for dir in "${CURRENT_THEME_DIRS[@]}"; do
  if [[ -f $dir/logseq.css ]]; then
    THEME_CSS="$dir/logseq.css"
    break
  fi
done

GRAPHS_FILE="$HOME/.config/omarchy-logseq/graphs"
LOGSEQ_GRAPHS_DIR="$HOME/.logseq/graphs"

BEGIN_MARKER="/* >>> omarchy-logseq: begin, do not edit >>> */"
END_MARKER="/* <<< omarchy-logseq: end <<< */"

MODE="apply"
[[ ${1:-} == "--remove" ]] && MODE="remove"

# Locate the graphs. A file at ~/.config/omarchy-logseq/graphs takes
# precedence, one path per line. Without it, paths are derived from the file
# names under ~/.logseq/graphs/, e.g. logseq_local_++home++you++notes.transit
graph_paths() {
  if [[ -f $GRAPHS_FILE ]]; then
    grep -v '^[[:space:]]*\(#\|$\)' "$GRAPHS_FILE" | sed "s|^~|$HOME|"
    return
  fi

  [[ -d $LOGSEQ_GRAPHS_DIR ]] || return

  local file name
  for file in "$LOGSEQ_GRAPHS_DIR"/*.transit; do
    [[ -f $file ]] || continue
    name=${file##*/}
    name=${name%.transit}
    name=${name#logseq_local_}
    printf '%s' "$name" | sed 's|++|/|g'
    printf '\n'
  done
}

# Print a file without our own section
strip_own_block() {
  awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" '
    $0 == begin { skipping = 1; next }
    skipping && $0 == end { skipping = 0; next }
    !skipping { print }
  ' "$1"
}

write_css() {
  local target=$1 tmp
  tmp=$(mktemp "${target%/*}/.custom.css.XXXXXX") || return 1

  [[ -f $target ]] && strip_own_block "$target" >"$tmp"

  if [[ $MODE == "apply" ]]; then
    {
      printf '%s\n' "$BEGIN_MARKER"
      cat "$THEME_CSS"
      printf '%s\n' "$END_MARKER"
    } >>"$tmp"
  fi

  chmod 644 "$tmp"
  mv "$tmp" "$target"
}

[[ $MODE == "apply" && -z $THEME_CSS ]] && exit 0

while read -r graph; do
  [[ -n $graph && -d $graph/logseq ]] || continue
  write_css "$graph/logseq/custom.css"
done < <(graph_paths)
